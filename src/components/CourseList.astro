---
import type { Course } from "../data/courses";

interface Props {
  courses: Course[];
}
const { courses } = Astro.props;
---
<ul class="courses">
  {courses.map((c) => (
    <li>
      <h3>
        {c.title}
        {c.level && <span class="level">{c.level}</span>}
      </h3>
      <p>{c.description}</p>
      {c.syllabus && (
        <p class="links">
          <a href={c.syllabus} target="_blank" rel="noopener">Syllabus</a>
        </p>
      )}
    </li>
  ))}
</ul>

<style>
  .courses { list-style: none; margin: 0; padding: 0; }
  li { padding: 1.25rem 0; border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  h3 { margin: 0 0 0.4rem; }
  p { margin: 0; color: var(--text); }
  .level {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0 0.6rem;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    vertical-align: middle;
  }
  .links { margin-top: 0.75rem; }
  .links a {
    font-size: 0.85rem;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    text-decoration: none;
  }
  .links a:hover { background: var(--accent); color: #fff; }
</style>
