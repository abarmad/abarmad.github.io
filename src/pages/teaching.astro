---
import Layout from "../layouts/Layout.astro";
import CourseList from "../components/CourseList.astro";
import { currentCourses, previousTeaching } from "../data/courses";
---
<Layout title="Teaching" description="Current and previous courses.">
  <div class="wrap page">
    <div class="prose">
      <h1>Teaching</h1>

      <section class="current">
        <h2>Currently Teaching at NYU Abu Dhabi</h2>
        <CourseList courses={currentCourses} />
      </section>

      <section class="previous">
        <h2>Previous Teaching Experience</h2>

        {previousTeaching.map((inst) => (
          <div class="institution">
            <h3 class="inst-name">
              {inst.name}
              {inst.period && <span class="period">{inst.period}</span>}
            </h3>

            <div class="inst-courses">
              <CourseList courses={inst.courses} />
            </div>

            {inst.photo && (
              <figure class="teaching-photo">
                <img src={inst.photo.src} alt={inst.photo.alt} loading="lazy" />
                <figcaption>{inst.photo.caption}</figcaption>
              </figure>
            )}
          </div>
        ))}
      </section>
    </div>
  </div>
</Layout>

<style>
  /* Text keeps its ~50rem width; the extra room on the right holds the photo. */
  .prose {
    --photo-w: 26rem;
    --photo-gap: 5rem;
    max-width: calc(50rem + var(--photo-w) + var(--photo-gap));
  }

  .prose > section { display: block; }

  /* Current teaching reserves the same right-hand space as the photo column,
     so every section has identical text widths. */
  .current { padding-right: calc(var(--photo-w) + var(--photo-gap)); }

  /* ---------- Each institution: courses on the left, its photo (if any) on the right ---------- */
  .institution {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--photo-w);
    column-gap: var(--photo-gap);
    align-items: start;
    margin-top: 2rem;
  }
  .previous .institution:first-of-type { margin-top: 0.5rem; }

  .inst-name,
  .inst-courses { grid-column: 1; }
  .inst-name { font-size: 1.35rem; margin-bottom: 0.25rem; }
  .period { margin-left: 0.6rem; font-family: var(--sans); font-size: 0.95rem; font-weight: 400; color: var(--muted); }

  .teaching-photo {
    grid-column: 2;
    grid-row: 1 / span 2;      /* sits beside the heading and the course list */
    margin: 0;
  }
  .teaching-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .teaching-photo figcaption {
    margin-top: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---------- Smaller screens: one column, photo comes right after its institution's courses ---------- */
  @media (max-width: 800px) {
    .current { padding-right: 0; }
    .institution { grid-template-columns: 1fr; }
    .teaching-photo {
      grid-column: 1;
      grid-row: auto;
      max-width: 24rem;
      margin-top: 1.25rem;
    }
  }
</style>