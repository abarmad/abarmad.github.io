---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { news } from "../data/news";

const NEWS_TITLE = "Recent Highlights";
const MAX_NEWS = 3;

const recent = [...news]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, MAX_NEWS);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const topics = [
  "Collective Decision-Making",
  "Bargaining and Negotiation Games",
  "Experimental Economics",
  "Behavioral Economics",
  "Economic Psychology",
  "Experimental Political Economy",
  "Experimental Game Theory",
];

// Add more links here; each one shows as a logo card in the side column.
const relatedLinks = [
  {
    name: "Social Science Experimental Laboratory (SSEL)",
    cta: "Visit the SSEL website",
    href: "https://ssel.abudhabi.nyu.edu/",
    logo: "/images/ssel_logo.png",
  },
];
---
<Layout>
  <div class="wrap page">
    <section class="hero">
      <div class="hero-text">
        <h1>{site.name}</h1>

        <p class="intro">
          I am an associate professor of economics at New York University Abu
          Dhabi, where I direct the Social Science Experimental Laboratory
          (SSEL) and the cluster of Experimental Social Science. I build and
          test models to better understand phenomena such as multilateral
          bargaining, contracting, and incentive provision in groups. I study
          the trade-off between productive and rent-seeking activities that
          arise in human organizations, and the mechanisms that promote
          efficiency in such settings.
        </p>

        <ul class="tags">
          {topics.map((t) => <li>{t}</li>)}
        </ul>
        <a class="more" href="/research">See publications →</a>

        {recent.length > 0 && (
          <section class="news" aria-labelledby="news-heading">
            <h2 id="news-heading">{NEWS_TITLE}</h2>
            <ul class="news-list">
              {recent.map((item) => (
                <li>
                  <p class="date">{formatDate(item.date)}</p>
                  <h3>{item.title}</h3>
                  {item.body &&
                    item.body.split("\n\n").map((para) => (
                      <p class="body">{para}</p>
                    ))}
                  {item.links && item.links.length > 0 && (
                    <p class="links">
                      {item.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                      ))}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <div class="hero-side">
        <img
          class="photo"
          src="/images/profile-photo.jpg"
          alt={`Portrait of ${site.name}`}
          width="800"
          height="800"
          fetchpriority="high"
        />
        <ul class="roles">
          {site.roles.map((role) => <li>{role}</li>)}
          <li class="affiliation">{site.affiliation}</li>
        </ul>

        <section class="related" aria-labelledby="links-heading">
          <h2 id="links-heading">Learn More About the Lab </h2>
          <ul class="link-list">
            {relatedLinks.map((l) => (
              <li>
                <a
                  class="link-card"
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${l.name} (opens in a new tab)`}
                >
                  <img src={l.logo} alt={`${l.name} logo`} loading="lazy" />
                  <span class="cta">
                    {l.cta} <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page { padding-top: 2rem; }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 3rem;
    align-items: start;
    padding-right: 1.5rem;        /* pulls the photo column in from the right edge */
  }
  .hero-text { max-width: none; }
  .intro, .hero .tags { max-width: none; }

  .intro {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .hero .tags { margin: 0 0 1rem; }
  .more { font-size: 0.95rem; }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 55% top;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .roles { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .roles li { color: var(--muted); font-size: 0.98rem; line-height: 1.5; }
  .roles .affiliation { color: var(--text); font-weight: 500; margin-top: 0.25rem; }

  /* ---------- Related links (logo cards, in the side column) ---------- */
  .related {
    border-top: 1px solid var(--line);
    margin-top: 1.75rem;
    padding-top: 1.5rem;
  }
  .related h2 { margin: 0 0 1rem; font-size: 1.15rem; }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .link-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .link-card img {
    display: block;
    width: calc(100% - 2.5rem);
    max-width: 14rem;
    height: auto;
    margin: 1.25rem auto 1rem;
  }
  /* button-style bar so it reads as clickable */
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .arrow { display: inline-block; transition: transform 0.15s; }
  .link-card:hover,
  .link-card:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 4px 14px rgba(11, 36, 71, 0.15);
    transform: translateY(-2px);
  }
  .link-card:hover .cta,
  .link-card:focus-visible .cta { background: var(--accent-dark); }
  .link-card:hover .arrow,
  .link-card:focus-visible .arrow { transform: translateX(4px); }

  /* ---------- News (stacked in the left column) ---------- */
  .news {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 6px;
    padding: 2rem 2.25rem 2.25rem;
    margin: 2.5rem 0 0;
    min-height: 24rem;
  }
  .news h2 { margin: 0 0 1.25rem; font-size: 1.3rem; }
  .news .body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 1rem;
  }
  .news-list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .news-list h3 { margin: 0 0 0.75rem; font-size: 1.2rem; }
  .news-list p { margin: 0 0 0.6rem; }
  .date {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  details { margin-bottom: 0.5rem; }
  summary { cursor: pointer; color: var(--accent); font-size: 0.9rem; }
  details p { margin-top: 0.6rem; color: var(--muted); font-size: 0.95rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0 0 !important; }
  .links a {
    font-size: 0.85rem;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    text-decoration: none;
  }
  .links a:hover { background: var(--accent); color: #fff; }

  /* ---------- Smaller screens ---------- */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 1.5rem; padding-right: 0; }
    .photo { max-width: 16rem; }
  }
</style>